[Unit]
Description=First-party Bluefin CountMe reporting
Documentation=https://countme.projectbluefin.io
Wants=network-online.target
After=network-online.target
ConditionPathExists=/run/ostree-booted
ConditionPathExists=!/etc/projectbluefin/countme/disabled
ConditionPathExists=!/etc/dakota-countme/disabled

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=bluefin-countme
ExecStart=/usr/libexec/bluefin-countme

# Nothing identifying is sent, and nothing outside its own state is read.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
# AF_UNIX and AF_NETLINK are required, not optional: glibc's getaddrinfo talks to
# nscd/nss-resolve over AF_UNIX and reads local interface state over AF_NETLINK,
# so restricting to AF_INET/AF_INET6 alone breaks name resolution.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallFilter=@system-service
